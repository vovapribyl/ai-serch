MVP_HOST=127.0.0.1
MVP_PORT=8000
MVP_POSTGRES_PORT=54329
MVP_POSTGRES_DB=mvp
MVP_POSTGRES_USER=mvp
# Укажите случайный секрет. Этот файл копируют ВНЕ репозитория с правами 600.
MVP_POSTGRES_PASSWORD=replace-with-a-random-local-secret
# Обязателен абсолютный путь вне репозитория, с правами 0700.
MVP_DATA_DIR=/absolute/path/to/product-search-mvp-data
